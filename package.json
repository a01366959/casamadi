{
  "name": "casamadi",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "audit:no-emoji": "sh scripts/audit-no-emoji.sh",
    "audit:docs-paths": "sh scripts/audit-doc-paths.sh",
    "project:audit": "pnpm audit:no-emoji && pnpm audit:docs-paths"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react-textarea-autosize": "^8.5.9"
  }
}
